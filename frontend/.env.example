# Copy to .env.local. Defaults shown.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 1 = serve every request from src/fixtures (no backend needed)
NEXT_PUBLIC_USE_FIXTURES=0
# Optional: link for the validation traceability report on the report card
NEXT_PUBLIC_REPO_URL=
# Optional: the live API's BV_DASHBOARD_TOKEN, sent as X-BV-Token (docs/03 §6.8, docs/deploy.md).
# Inlined into the browser bundle: it keeps casual traffic off a private instance, it is not authentication.
NEXT_PUBLIC_BV_DASHBOARD_TOKEN=
