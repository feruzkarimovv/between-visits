# Copy to .env and fill in. Never commit .env.
# Demo mode needs nothing below except DEMO_MODE=1.

# --- Core ---
APP_ENV=dev                       # dev | demo | prod
DEMO_MODE=0                       # 1 = no external calls (fake Gemini, console pager, replay only)
PUBLIC_BASE_URL=https://your-name.ngrok-free.app   # public HTTPS URL of the backend (make tunnel)
NGROK_DOMAIN=your-name.ngrok-free.app              # your free ngrok dev domain (copy it from the ngrok dashboard)
DATABASE_URL=sqlite:///./backend/data/app.db
CORS_ORIGINS=http://localhost:3000
# With DEMO_MODE=0 the backend refuses to start if TOOL_SHARED_SECRET is empty, this placeholder or shorter
# than 24 characters. Generate one: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
TOOL_SHARED_SECRET=change-me-long-random-string    # sent by ElevenLabs tools as X-BV-Tool-Secret
DISPLAY_TZ=America/New_York
ACK_TIMEOUT_SECONDS=90            # re-page if the nurse hasn't pressed 1
# REPLAY_SPEED=2                  # default demo replay multiplier (unset = 2 in demo mode); ?speed=1|2|4 overrides it
# MONITORING_OUT=monitoring/out   # committed Site Signal outputs (default <repo>/monitoring/out; relative = from the repo root)

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=        # post-call webhook HMAC secret (from the ElevenLabs webhook settings)
ELEVENLABS_PHONE_NUMBER_ID=       # ID of the Twilio number imported into ElevenLabs
ELEVENLABS_LLM=claude-sonnet-5-5  # agent LLM, pinned to the evaluated model (agent/variants.json, docs/04-voice-agent.md)
# TTS model is pinned per language in agent/variants.json (en: eleven_flash_v2, es: eleven_flash_v2_5).
# Optional overrides: ELEVENLABS_TTS_MODEL_EN / ELEVENLABS_TTS_MODEL_ES
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_ES=
# agent IDs are written by `make sync-agent` to agent/agents.lock.json (gitignored)

# --- Claude (Anthropic API): post-call extraction, safety net, translation, SAE narratives, eval ---
LLM_PROVIDER=auto                 # auto = Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY, else fake
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-opus-5-5   # extraction, translation (claude-haiku-5-5 is much cheaper)
CLAUDE_MODEL_LONG=claude-opus-5-5   # safety net, narratives
CLAUDE_MODEL_PATIENT=claude-sonnet-5-5   # eval's simulated patient (empty = CLAUDE_MODEL_FAST)

# --- Gemini (alternative backend provider; was the voice-agent LLM before the V9 pin) ---
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite   # extraction, translation (structured JSON)
GEMINI_MODEL_LONG=gemini-3.8-flash        # safety net, narratives, protocol PDFs (thinking level low)
GEMINI_AGENT_SIM_MODEL=gemini-3.5-flash   # eval agent simulator: must equal ELEVENLABS_LLM if your project has it, else use gemini-3.5-flash-lite for both
# Link billing and prepay $5 in AI Studio: the free tier is too small for the evaluation

# --- Twilio (number used by ElevenLabs; upgraded account + approved Primary Compliance Profile required for outbound) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# --- Paging ---
PAGER_CHANNEL=ntfy                # ntfy (default) | twilio_voice (optional) | console (demo mode)
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=bv-change-me-to-a-long-random-string     # anyone with the topic name can read it: subject IDs only
NTFY_BACKUP_TOPIC=bv-change-me-backup-long-random
ONCALL_NURSE_NAME=RN on call
ONCALL_NURSE_PHONE=+1XXXXXXXXXX   # a teammate's verified phone
BACKUP_INVESTIGATOR_NAME=Dr. on call
BACKUP_INVESTIGATOR_PHONE=+1XXXXXXXXXX

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_USE_FIXTURES=0
